# Copy to .env.local và điền từ Supabase → Project Settings → API
# Khi cả hai dòng dưới có giá trị (không rỗng), app dùng Supabase (auth + repository).
VITE_SUPABASE_URL=
# Anon key (JWT eyJ...) hoặc Publishable key (sb_publishable_...) đều được.
VITE_SUPABASE_ANON_KEY=

# Setup Hệ thống (lần đầu):
#   1. npx supabase link && npx supabase db push
#   2. npm run seed:demo
#   3. Tạo user Auth: <ten_tai_khoan>@gmail.com (vd. nguyen.quoc.hung@gmail.com)
#   4. npm run verify:supabase — kiểm tra env + số dòng DB

# Tuỳ chọn: ép dùng mock toàn app dù đã điền URL/key (ví dụ khi dev).
# VITE_FORCE_MOCK=true

# Bắt buộc khi dùng Supabase + phân quyền theo chức vụ (var_phan_quyen + id_chuc_vu trên nhân viên).
# Tắt = legacy mode (mọi người xem được, không CRUD — cap_bac=1 không có hiệu lực).
VITE_USE_PERMISSION_MATRIX=true

# Deprecated: VITE_DATA_SOURCE=mock vẫn được hỗ trợ để ép mock (tương thích .env cũ).
